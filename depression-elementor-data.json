[{"id": "dep1a2b3c", "elType": "container", "isInner": false, "isLocked": false, "settings": {"content_width": "full", "flex_direction": "column", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "dep4d5e6f", "elType": "widget", "isInner": false, "isLocked": false, "widgetType": "html", "settings": {"html": "<!--\n  DEPRESSION LANDINGSSIDE — psykoterapeut.net\n  Bygget som ren HTML til WordPress Custom HTML block\n  Matcher stress-sidens design: samme farver, fonte, layout\n  Primærfarve: #744245 | Baggrund: #F4EBE4\n  Upload via: landing-pages/update-page ability med post_content\n-->\n\n<!-- ============================================================\n     SEKTION 1: HERO\n     ============================================================ -->\n<style>\n/* =====================================================\n   DEPRESSION SIDE — GLOBAL WRAPPER STYLES\n   Alle sektioner er self-contained med præfikset .im-dep-\n   ===================================================== */\n\n/* Reset og basis */\n.im-dep-page * {\n  box-sizing: border-box;\n}\n\n.im-dep-page {\n  font-family: 'Inter', sans-serif;\n  color: #3d3530;\n  line-height: 1.6;\n}\n\n.im-dep-page h1,\n.im-dep-page h2,\n.im-dep-page h3,\n.im-dep-page h4 {\n  font-family: 'Inter', sans-serif;\n  color: #2a1f1b;\n  line-height: 1.25;\n}\n\n.im-dep-page em {\n  font-family: 'Cardo', serif;\n  font-style: italic;\n}\n\n/* =====================================================\n   HERO SEKTION\n   ===================================================== */\n.im-dep-hero {\n  background: #F4EBE4;\n  padding: 90px 24px 80px;\n}\n\n.im-dep-hero-inner {\n  max-width: 760px;\n  margin: 0 auto;\n  text-align: center;\n}\n\n.im-dep-hero h1 {\n  font-size: clamp(2rem, 5vw, 3.2rem);\n  font-weight: 700;\n  margin-bottom: 28px;\n  letter-spacing: -0.02em;\n}\n\n.im-dep-hero-intro {\n  font-size: 1.15rem;\n  max-width: 620px;\n  margin: 0 auto 44px;\n  color: #5a4a44;\n}\n\n.im-dep-hero-cta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 20px;\n  align-items: center;\n  justify-content: center;\n}\n\n.im-dep-btn-primary {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  background: #744245;\n  color: #fff;\n  padding: 18px 40px;\n  border-radius: 999px;\n  font-size: 16px;\n  font-weight: 600;\n  text-decoration: none;\n  transition: all 0.3s ease;\n  box-shadow: 0 8px 25px rgba(116, 66, 69, 0.25);\n}\n\n.im-dep-btn-primary:hover {\n  background: #5e3538;\n  transform: translateY(-3px);\n  box-shadow: 0 12px 35px rgba(116, 66, 69, 0.35);\n  color: #fff;\n}\n\n.im-dep-phone-box {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n}\n\n.im-dep-phone-label {\n  font-size: 11px;\n  text-transform: uppercase;\n  letter-spacing: 2px;\n  color: #744245;\n  font-weight: 600;\n}\n\n.im-dep-phone-number {\n  font-size: 1.3rem;\n  font-weight: 700;\n  color: #2a1f1b;\n  text-decoration: none;\n}\n\n.im-dep-phone-number:hover {\n  color: #744245;\n}\n\n.im-dep-badges {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  justify-content: center;\n  margin-top: 48px;\n}\n\n.im-dep-badge {\n  background: #fff;\n  border: 1px solid #e2ddd6;\n  border-radius: 999px;\n  padding: 8px 20px;\n  font-size: 13px;\n  color: #5a4a44;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n@media (max-width: 640px) {\n  .im-dep-hero {\n    padding: 70px 20px 60px;\n  }\n  .im-dep-phone-box {\n    align-items: center;\n  }\n}\n</style>\n\n<div class=\"im-dep-page\">\n\n<section class=\"im-dep-hero\">\n  <div class=\"im-dep-hero-inner\">\n    <h1>Depression behandling gennem <em>terapi</em></h1>\n    <p class=\"im-dep-hero-intro\">\n      Mærker du tomheden indefra — at alt føles tungt, fladt og uden mening, selvom der ingen synlig grund er?\n      <br><br>\n      Jeg kender vejen fra mørke til lys igen. I mine samtaler lærer du ikke bare at håndtere depression. Du lærer at forstå hvad der holder dig nede, så du kan finde dig selv igen.\n    </p>\n    <div class=\"im-dep-hero-cta\">\n      <a href=\"https://www.psykoterapeut.net/book-samtale/\" class=\"im-dep-btn-primary\">\n        Book gratis møde\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M12 5l7 7-7 7\"/></svg>\n      </a>\n      <div class=\"im-dep-phone-box\">\n        <span class=\"im-dep-phone-label\">giv mig et kald:</span>\n        <a href=\"tel:29930110\" class=\"im-dep-phone-number\">29930110</a>\n      </div>\n    </div>\n    <div class=\"im-dep-badges\">\n      <span class=\"im-dep-badge\">✓ Autoriseret psykoterapeut</span>\n      <span class=\"im-dep-badge\">✓ Gratis første møde</span>\n      <span class=\"im-dep-badge\">✓ Tavshedspligt</span>\n    </div>\n  </div>\n</section>\n\n\n<!-- ============================================================\n     SEKTION 2: SÅDAN ARBEJDER VI SAMMEN\n     ============================================================ -->\n<style>\n.im-dep-approach {\n  background: #fff;\n  padding: 90px 24px;\n}\n\n.im-dep-approach-inner {\n  max-width: 1100px;\n  margin: 0 auto;\n}\n\n.im-dep-approach-header {\n  text-align: center;\n  margin-bottom: 60px;\n}\n\n.im-dep-approach-header h2 {\n  font-size: clamp(1.6rem, 4vw, 2.4rem);\n  font-weight: 700;\n}\n\n.im-dep-approach-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 32px;\n}\n\n.im-dep-approach-card {\n  background: #F4EBE4;\n  border-radius: 20px;\n  padding: 40px 32px;\n  transition: transform 0.3s ease, box-shadow 0.3s ease;\n}\n\n.im-dep-approach-card:hover {\n  transform: translateY(-6px);\n  box-shadow: 0 20px 50px rgba(0,0,0,0.08);\n}\n\n.im-dep-approach-step {\n  font-size: 11px;\n  text-transform: uppercase;\n  letter-spacing: 2px;\n  color: #744245;\n  font-weight: 700;\n  margin-bottom: 12px;\n}\n\n.im-dep-approach-card h3 {\n  font-size: 1.25rem;\n  font-weight: 700;\n  margin-bottom: 16px;\n}\n\n.im-dep-approach-card p {\n  font-size: 15px;\n  color: #5a4a44;\n  line-height: 1.7;\n  margin: 0;\n}\n\n.im-dep-approach-cta {\n  text-align: center;\n  margin-top: 50px;\n}\n\n@media (max-width: 900px) {\n  .im-dep-approach-grid {\n    grid-template-columns: 1fr;\n    gap: 24px;\n  }\n}\n</style>\n\n<section class=\"im-dep-approach\">\n  <div class=\"im-dep-approach-inner\">\n    <header class=\"im-dep-approach-header\">\n      <h2>Sådan arbejder vi sammen med <em>depression</em></h2>\n    </header>\n    <div class=\"im-dep-approach-grid\">\n\n      <article class=\"im-dep-approach-card\">\n        <p class=\"im-dep-approach-step\">Vi starter her</p>\n        <h3>Vi starter med det du mærker</h3>\n        <p>Når du kommer til mig med depression, starter vi ikke med diagnoser eller forklaringer. Vi starter med det du mærker: Tyngden i kroppen. Tomheden. Følelsen af at være afskåret fra dig selv og andre.<br><br>I vores samtaler får din depression lov at være der — uden at du skal præstere eller have overskud. Vi undersøger sammen, med nysgerrighed og nænsomhed, hvad der bærer din tyngde. I dit tempo.</p>\n      </article>\n\n      <article class=\"im-dep-approach-card\">\n        <p class=\"im-dep-approach-step\">Dybereliggende årsager</p>\n        <h3>Hvorfor føler du det du føler?</h3>\n        <p>Depression handler sjældent kun om det der sker nu — det handler også om mønstre der har ligget dybt nede i lang tid. Måske har du vænnet dig til at skjule din smerte, altid fungere udadtil, eller aldrig rigtig have fået plads til dine egne behov.<br><br>Sammen undersøger vi hvor disse mønstre kommer fra, og hvad de gør ved dig i dag. Forståelse er det første skridt mod frihed.</p>\n      </article>\n\n      <article class=\"im-dep-approach-card\">\n        <p class=\"im-dep-approach-step\">Vejen frem</p>\n        <h3>Kroppen og sindet hænger sammen</h3>\n        <p>Depression sætter sig i kroppen. Måske mærker du en konstant træthed, en tyngde der ikke vil slippe, eller en følelsesløshed der gør verden grå.<br><br>Derfor arbejder vi også med kroppen, åndedrættet og de fysiske fornemmelser. Når din krop begynder at tø op, åbner der sig muligheder i sindet. Du finder vej tilbage til dig selv — og til livet.</p>\n      </article>\n\n    </div>\n    <div class=\"im-dep-approach-cta\">\n      <a href=\"https://www.psykoterapeut.net/om-min-tilgang/\" class=\"im-dep-btn-primary\">\n        Lær mere om min tilgang\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M12 5l7 7-7 7\"/></svg>\n      </a>\n    </div>\n  </div>\n</section>\n\n\n<!-- ============================================================\n     SEKTION 3: SYMPTOMER PÅ DEPRESSION\n     ============================================================ -->\n<style>\n.im-dep-symptoms-section {\n  background: #fff;\n  padding: 90px 24px;\n}\n\n.im-dep-symptoms-container {\n  max-width: 1100px;\n  margin: 0 auto;\n}\n\n.im-dep-symptoms-header {\n  text-align: center;\n  margin-bottom: 60px;\n}\n\n.im-dep-symptoms-header h2 {\n  font-size: clamp(1.6rem, 4vw, 2.4rem);\n  font-weight: 700;\n}\n\n.im-dep-symptoms-header p {\n  max-width: 600px;\n  margin: 20px auto 0;\n  color: #5a4a44;\n}\n\n.im-dep-symptoms-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 28px;\n  margin-bottom: 60px;\n}\n\n.im-dep-symptom-card {\n  background: #F4EBE4;\n  border-radius: 16px;\n  padding: 32px 28px;\n  transition: transform 0.4s ease, box-shadow 0.4s ease;\n}\n\n.im-dep-symptom-card:hover {\n  transform: translateY(-6px);\n  box-shadow: 0 24px 55px rgba(0,0,0,0.08);\n}\n\n.im-dep-card-header {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  margin-bottom: 24px;\n  padding-bottom: 18px;\n  border-bottom: 1px solid #d8cfc8;\n}\n\n.im-dep-card-icon {\n  width: 48px;\n  height: 48px;\n  border-radius: 12px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 22px;\n  flex-shrink: 0;\n  background: linear-gradient(135deg, #FCEAE8 0%, #F9D5D1 100%);\n}\n\n.im-dep-card-title {\n  margin: 0;\n  font-size: 1.05rem;\n  font-weight: 700;\n}\n\n.im-dep-symptom-list {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n\n.im-dep-symptom-item {\n  padding: 12px 16px;\n  margin: 0 -16px;\n  border-radius: 10px;\n  font-size: 14px;\n  color: #5a4a44;\n  transition: all 0.3s ease;\n  line-height: 1.5;\n}\n\n.im-dep-symptom-item:hover {\n  background: rgba(116, 66, 69, 0.05);\n  transform: translateX(6px);\n}\n\n.im-dep-symptoms-footer {\n  text-align: center;\n}\n\n.im-dep-symptoms-footer p {\n  margin: 0 0 28px;\n  color: #5a4a44;\n}\n\n@media (max-width: 900px) {\n  .im-dep-symptoms-section {\n    padding: 70px 20px;\n  }\n  .im-dep-symptoms-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n\n@media (max-width: 640px) {\n  .im-dep-symptoms-grid {\n    grid-template-columns: 1fr;\n    gap: 20px;\n  }\n}\n</style>\n\n<section class=\"im-dep-symptoms-section\">\n  <div class=\"im-dep-symptoms-container\">\n\n    <header class=\"im-dep-symptoms-header\">\n      <h2>Kender du disse <em>tegn på depression?</em></h2>\n      <p>Når mine klienter kommer til mig med depression, fortæller de ofte om de samme signaler. Genkender du dig selv i nogle af disse?</p>\n    </header>\n\n    <div class=\"im-dep-symptoms-grid\">\n\n      <article class=\"im-dep-symptom-card\">\n        <div class=\"im-dep-card-header\">\n          <div class=\"im-dep-card-icon\">🫀</div>\n          <h3 class=\"im-dep-card-title\">I kroppen</h3>\n        </div>\n        <ul class=\"im-dep-symptom-list\">\n          <li class=\"im-dep-symptom-item\">Konstant træthed — selv søvn hjælper ikke</li>\n          <li class=\"im-dep-symptom-item\">En tyngde i kroppen der er svær at beskrive</li>\n          <li class=\"im-dep-symptom-item\">Appetitforandringer — ingen sult eller trøstespisning</li>\n          <li class=\"im-dep-symptom-item\">Ondt i kroppen uden nogen klar årsag</li>\n        </ul>\n      </article>\n\n      <article class=\"im-dep-symptom-card\">\n        <div class=\"im-dep-card-header\">\n          <div class=\"im-dep-card-icon\">🧠</div>\n          <h3 class=\"im-dep-card-title\">I sindet</h3>\n        </div>\n        <ul class=\"im-dep-symptom-list\">\n          <li class=\"im-dep-symptom-item\">Tomhed — ingenting føles rigtigt glædeligt</li>\n          <li class=\"im-dep-symptom-item\">Tankerne kredser om selvkritik og håbløshed</li>\n          <li class=\"im-dep-symptom-item\">Svært at koncentrere sig eller træffe beslutninger</li>\n          <li class=\"im-dep-symptom-item\">En indre stemme der siger: \"hvad er meningen?\"</li>\n        </ul>\n      </article>\n\n      <article class=\"im-dep-symptom-card\">\n        <div class=\"im-dep-card-header\">\n          <div class=\"im-dep-card-icon\">🌿</div>\n          <h3 class=\"im-dep-card-title\">I hverdagen</h3>\n        </div>\n        <ul class=\"im-dep-symptom-list\">\n          <li class=\"im-dep-symptom-item\">Trækker dig fra venner og familie</li>\n          <li class=\"im-dep-symptom-item\">Mister interessen for ting du plejede at elske</li>\n          <li class=\"im-dep-symptom-item\">Svært at komme ud af sengen eller komme i gang</li>\n          <li class=\"im-dep-symptom-item\">Lever livet men mærker dig ikke selv i det</li>\n        </ul>\n      </article>\n\n    </div>\n\n    <footer class=\"im-dep-symptoms-footer\">\n      <p>Genkender du dig selv? Så er du ikke alene.<br><strong>Og vigtigst af alt: det kan ændres.</strong></p>\n      <a href=\"https://www.psykoterapeut.net/book-samtale/\" class=\"im-dep-btn-primary\">\n        Book gratis møde\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M12 5l7 7-7 7\"/></svg>\n      </a>\n    </footer>\n\n  </div>\n</section>\n\n\n<!-- ============================================================\n     SEKTION 4: HVAD KAN DU FORVENTE AF FORLØBET\n     ============================================================ -->\n<style>\n.im-dep-forloeb-section {\n  background: #F4EBE4;\n  padding: 90px 24px;\n}\n\n.im-dep-forloeb-container {\n  max-width: 1100px;\n  margin: 0 auto;\n}\n\n.im-dep-forloeb-header {\n  text-align: center;\n  margin-bottom: 50px;\n}\n\n.im-dep-forloeb-header h2 {\n  font-size: clamp(1.6rem, 4vw, 2.4rem);\n  font-weight: 700;\n}\n\n.im-dep-forloeb-header p {\n  max-width: 700px;\n  margin: 16px auto 0;\n  color: #5a4a44;\n}\n\n.im-dep-forloeb-grid {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 28px;\n}\n\n.im-dep-forloeb-card {\n  background: #fff;\n  border-radius: 16px;\n  padding: 32px 28px;\n  box-shadow: 0 18px 45px rgba(0,0,0,0.06);\n  transition: box-shadow 0.3s ease, transform 0.3s ease;\n}\n\n.im-dep-forloeb-card:hover {\n  box-shadow: 0 24px 55px rgba(0,0,0,0.1);\n  transform: translateY(-4px);\n}\n\n.im-dep-forloeb-icon {\n  width: 48px;\n  height: 48px;\n  background: linear-gradient(135deg, #FCEAE8 0%, #F9D5D1 100%);\n  border-radius: 12px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-bottom: 20px;\n  font-size: 24px;\n}\n\n.im-dep-forloeb-fase {\n  font-size: 11px;\n  text-transform: uppercase;\n  letter-spacing: 1.5px;\n  color: #744245;\n  font-weight: 700;\n  margin-bottom: 8px;\n}\n\n.im-dep-forloeb-card h3 {\n  font-size: 1.15rem;\n  font-weight: 700;\n  margin-bottom: 14px;\n}\n\n.im-dep-forloeb-card > p {\n  font-size: 14px;\n  color: #5a4a44;\n  line-height: 1.7;\n  margin-bottom: 20px;\n}\n\n.im-dep-forloeb-liste {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n\n.im-dep-forloeb-liste li {\n  padding: 6px 0 6px 24px;\n  position: relative;\n  font-size: 14px;\n  color: #5a4a44;\n}\n\n.im-dep-forloeb-liste li::before {\n  content: \"→\";\n  position: absolute;\n  left: 0;\n  color: #744245;\n}\n\n.im-dep-forloeb-footer {\n  text-align: center;\n  margin-top: 50px;\n  max-width: 750px;\n  margin-left: auto;\n  margin-right: auto;\n}\n\n.im-dep-forloeb-footer p {\n  color: #5a4a44;\n  font-style: italic;\n}\n\n@media (max-width: 640px) {\n  .im-dep-forloeb-section {\n    padding: 70px 20px;\n  }\n  .im-dep-forloeb-grid {\n    grid-template-columns: 1fr;\n    gap: 20px;\n  }\n  .im-dep-forloeb-card {\n    padding: 28px 24px;\n  }\n}\n</style>\n\n<section class=\"im-dep-forloeb-section\">\n  <div class=\"im-dep-forloeb-container\">\n\n    <header class=\"im-dep-forloeb-header\">\n      <h2>Hvad kan du forvente af <em>vores forløb?</em></h2>\n      <p>Mange spørger mig: \"Hvad sker der egentlig i terapi for depression?\" Her er de faser, de fleste oplever — og hvad de typisk mærker undervejs</p>\n    </header>\n\n    <div class=\"im-dep-forloeb-grid\">\n\n      <article class=\"im-dep-forloeb-card\">\n        <div class=\"im-dep-forloeb-icon\">🌱</div>\n        <p class=\"im-dep-forloeb-fase\">I starten</p>\n        <h3>Blive set og hørt</h3>\n        <p>Vi arbejder med at skabe et trygt rum, hvor du ikke behøver præstere eller \"have det godt nok\" til at komme. Du må komme præcis som du er.</p>\n        <ul class=\"im-dep-forloeb-liste\">\n          <li>Lettelse ved at dele det du bærer</li>\n          <li>Begynde at forstå dine mønstre</li>\n          <li>Lidt mere energi til hverdagen</li>\n          <li>Første glimt af håb</li>\n        </ul>\n      </article>\n\n      <article class=\"im-dep-forloeb-card\">\n        <div class=\"im-dep-forloeb-icon\">🔍</div>\n        <p class=\"im-dep-forloeb-fase\">Undervejs</p>\n        <h3>Forstå rødderne</h3>\n        <p>Vi begynder at grave dybere i hvad der holder dig nede. Hvilke tanker og mønstre styrker depressionen? Hvad kender du igen fra din fortid?</p>\n        <ul class=\"im-dep-forloeb-liste\">\n          <li>Øget selvindsigt og selvforståelse</li>\n          <li>Begynde at se egne behov</li>\n          <li>Mere kontakt med egne følelser</li>\n          <li>Langsomt mere overskud</li>\n        </ul>\n      </article>\n\n      <article class=\"im-dep-forloeb-card\">\n        <div class=\"im-dep-forloeb-icon\">✨</div>\n        <p class=\"im-dep-forloeb-fase\">Når vi går dybere</p>\n        <h3>Finde sig selv igen</h3>\n        <p>De dybere mønstre begynder at løsne sig. Du begynder at genkende dig selv igen — og mærke at du har en plads i dit eget liv.</p>\n        <ul class=\"im-dep-forloeb-liste\">\n          <li>Mere glæde og tilstedeværelse</li>\n          <li>Bedre relationer og kontakt med andre</li>\n          <li>Nemmere at sætte grænser</li>\n          <li>Færre og kortere perioder med nedtrykthed</li>\n        </ul>\n      </article>\n\n      <article class=\"im-dep-forloeb-card\">\n        <div class=\"im-dep-forloeb-icon\">🌳</div>\n        <p class=\"im-dep-forloeb-fase\">Langsigtet</p>\n        <h3>Et liv du kan mærke</h3>\n        <p>Du har redskaberne til at navigere fremtidige svære perioder. Du kender dig selv bedre — og ved at du kan bære mere end du troede.</p>\n        <ul class=\"im-dep-forloeb-liste\">\n          <li>Redskaber til resten af livet</li>\n          <li>Tidlig genkendelse af advarselssignaler</li>\n          <li>Tillid til egne ressourcer og styrker</li>\n          <li>Et liv i balance — på dine egne præmisser</li>\n        </ul>\n      </article>\n\n    </div>\n\n    <footer class=\"im-dep-forloeb-footer\">\n      <p>Ethvert forløb er unikt og starter fra et forskelligt sted. Se dette som en guide — din egen vej kan se anderledes ud.</p>\n    </footer>\n\n  </div>\n</section>\n\n\n<!-- ============================================================\n     SEKTION 5: TAG DET NÆSTE SKRIDT (CTA)\n     ============================================================ -->\n<style>\n.im-dep-cta-section {\n  background: #fff;\n  padding: 90px 24px;\n}\n\n.im-dep-cta-inner {\n  max-width: 760px;\n  margin: 0 auto;\n  text-align: center;\n}\n\n.im-dep-cta-inner h2 {\n  font-size: clamp(1.6rem, 4vw, 2.4rem);\n  font-weight: 700;\n  margin-bottom: 12px;\n}\n\n.im-dep-cta-subtitle {\n  font-size: 1.4rem;\n  font-weight: 700;\n  color: #744245;\n  margin-bottom: 24px;\n}\n\n.im-dep-cta-inner p {\n  font-size: 16px;\n  color: #5a4a44;\n  max-width: 620px;\n  margin: 0 auto 44px;\n  line-height: 1.7;\n}\n\n.im-dep-cta-buttons {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 20px;\n  justify-content: center;\n  align-items: center;\n}\n\n@media (max-width: 640px) {\n  .im-dep-cta-section {\n    padding: 70px 20px;\n  }\n}\n</style>\n\n<section class=\"im-dep-cta-section\">\n  <div class=\"im-dep-cta-inner\">\n    <h2>Tag det næste skridt</h2>\n    <p class=\"im-dep-cta-subtitle\">Et helhedsorienteret forløb</p>\n    <p>\n      Jeg lægger vægt på at skabe et trygt, roligt og nærværende rum, hvor du kan være præcis som du er — uden krav om at præstere eller skulle noget bestemt.<br><br>\n      Mit mål er ikke blot at du skal \"komme fri af depression\", men at du får mulighed for at forstå dig selv på en ny måde og finde en mere frugtbar balance i dit liv.\n    </p>\n    <div class=\"im-dep-cta-buttons\">\n      <a href=\"https://www.psykoterapeut.net/book-samtale/\" class=\"im-dep-btn-primary\">\n        Book gratis møde\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M12 5l7 7-7 7\"/></svg>\n      </a>\n      <div class=\"im-dep-phone-box\">\n        <span class=\"im-dep-phone-label\">giv mig et kald:</span>\n        <a href=\"tel:29930110\" class=\"im-dep-phone-number\">+ 29930110</a>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<!-- ============================================================\n     SEKTION 6: TESTIMONIALS PLACEHOLDER\n     ============================================================ -->\n<style>\n.im-dep-testimonials {\n  background: #F4EBE4;\n  padding: 90px 24px;\n}\n\n.im-dep-testimonials-inner {\n  max-width: 1100px;\n  margin: 0 auto;\n}\n\n.im-dep-testimonials-header {\n  text-align: center;\n  margin-bottom: 60px;\n}\n\n.im-dep-testimonials-header h2 {\n  font-size: clamp(1.6rem, 4vw, 2.4rem);\n  font-weight: 700;\n}\n\n.im-dep-testimonials-header p {\n  color: #5a4a44;\n  margin-top: 12px;\n}\n\n.im-dep-testimonials-grid {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 28px;\n}\n\n.im-dep-testimonial-card {\n  background: #fff;\n  border-radius: 16px;\n  padding: 32px;\n  box-shadow: 0 10px 30px rgba(0,0,0,0.05);\n}\n\n.im-dep-testimonial-quote {\n  font-size: 15px;\n  color: #3d3530;\n  line-height: 1.7;\n  font-style: italic;\n  margin-bottom: 24px;\n  padding-left: 20px;\n  border-left: 3px solid #744245;\n}\n\n.im-dep-testimonial-author {\n  font-size: 13px;\n  font-weight: 700;\n  color: #744245;\n}\n\n@media (max-width: 640px) {\n  .im-dep-testimonials {\n    padding: 70px 20px;\n  }\n  .im-dep-testimonials-grid {\n    grid-template-columns: 1fr;\n  }\n}\n</style>\n\n<section class=\"im-dep-testimonials\">\n  <div class=\"im-dep-testimonials-inner\">\n    <header class=\"im-dep-testimonials-header\">\n      <h2>Hvad siger mine klienter</h2>\n      <p>Ord fra dem, jeg har haft fornøjelsen af at hjælpe</p>\n    </header>\n    <div class=\"im-dep-testimonials-grid\">\n      <article class=\"im-dep-testimonial-card\">\n        <p class=\"im-dep-testimonial-quote\">Jeg kom til Inger Marie med en tomhed jeg slet ikke kunne forklare. Efter nogle få samtaler begyndte jeg at forstå mig selv på en helt ny måde. Jeg genfandt min energi og glæden ved hverdagen.</p>\n        <span class=\"im-dep-testimonial-author\">— Kvinde, 38 år</span>\n      </article>\n      <article class=\"im-dep-testimonial-card\">\n        <p class=\"im-dep-testimonial-quote\">Jeg var skeptisk over for terapi, men Inger Marie skabte et rum hvor jeg følte mig tryg og set. For første gang i lang tid taler jeg igen med mine nærmeste og kan mærke mig selv.</p>\n        <span class=\"im-dep-testimonial-author\">— Mand, 44 år</span>\n      </article>\n    </div>\n  </div>\n</section>\n\n\n<!-- ============================================================\n     SEKTION 7: TILLID — FORTROLIGT / INDIVIDUEL / ERFAREN\n     ============================================================ -->\n<style>\n.im-dep-trust-section {\n  background: #fff;\n  padding: 80px 24px;\n}\n\n.im-dep-trust-inner {\n  max-width: 1100px;\n  margin: 0 auto;\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 32px;\n}\n\n.im-dep-trust-card {\n  text-align: center;\n  padding: 32px 24px;\n  background: #F4EBE4;\n  border-radius: 16px;\n}\n\n.im-dep-trust-icon {\n  font-size: 2rem;\n  margin-bottom: 16px;\n}\n\n.im-dep-trust-card h3 {\n  font-size: 1.1rem;\n  font-weight: 700;\n  margin-bottom: 12px;\n}\n\n.im-dep-trust-card p {\n  font-size: 14px;\n  color: #5a4a44;\n  line-height: 1.6;\n  margin: 0;\n}\n\n@media (max-width: 640px) {\n  .im-dep-trust-section {\n    padding: 60px 20px;\n  }\n  .im-dep-trust-inner {\n    grid-template-columns: 1fr;\n    gap: 20px;\n  }\n}\n</style>\n\n<section class=\"im-dep-trust-section\">\n  <div class=\"im-dep-trust-inner\">\n    <article class=\"im-dep-trust-card\">\n      <div class=\"im-dep-trust-icon\">🔒</div>\n      <h3>Fortroligt</h3>\n      <p>Alt hvad vi taler om er dækket af tavshedspligt. Du får et trygt rum hvor du kan være ægte og sårbar uden frygt for at det går videre.</p>\n    </article>\n    <article class=\"im-dep-trust-card\">\n      <div class=\"im-dep-trust-icon\">🤝</div>\n      <h3>Individuel</h3>\n      <p>Hver samtale tilpasses dine specifikke behov. Vi finder sammen den vej der passer bedst til dig og din livssituation.</p>\n    </article>\n    <article class=\"im-dep-trust-card\">\n      <div class=\"im-dep-trust-icon\">🎓</div>\n      <h3>Erfaren</h3>\n      <p>Over 3 års erfaring som autoriseret psykoterapeut. Løbende supervision og efteruddannelse sikrer at du får den bedste hjælp.</p>\n    </article>\n  </div>\n</section>\n\n\n<!-- ============================================================\n     SEKTION 8: FOKUSOMRÅDER\n     ============================================================ -->\n<style>\n.im-dep-focus-section {\n  background: #F4EBE4;\n  padding: 80px 24px;\n}\n\n.im-dep-focus-inner {\n  max-width: 900px;\n  margin: 0 auto;\n  text-align: center;\n}\n\n.im-dep-focus-inner h2 {\n  font-size: clamp(1.4rem, 3vw, 2rem);\n  font-weight: 700;\n  margin-bottom: 40px;\n}\n\n.im-dep-focus-grid {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  justify-content: center;\n}\n\n.im-dep-focus-tag {\n  background: #fff;\n  border: 2px solid #e2ddd6;\n  border-radius: 999px;\n  padding: 12px 24px;\n  font-size: 14px;\n  font-weight: 600;\n  color: #3d3530;\n  text-decoration: none;\n  transition: all 0.25s ease;\n}\n\n.im-dep-focus-tag:hover,\n.im-dep-focus-tag.im-dep-focus-tag--active {\n  background: #744245;\n  border-color: #744245;\n  color: #fff;\n}\n</style>\n\n<section class=\"im-dep-focus-section\">\n  <div class=\"im-dep-focus-inner\">\n    <h2><em>Fokusområder</em> i min praksis</h2>\n    <div class=\"im-dep-focus-grid\">\n      <span class=\"im-dep-focus-tag im-dep-focus-tag--active\">Depression</span>\n      <a href=\"https://www.psykoterapeut.net/terapi-mod-angst/\" class=\"im-dep-focus-tag\">Angst</a>\n      <a href=\"https://www.psykoterapeut.net/terapi-mod-stress/\" class=\"im-dep-focus-tag\">Stress og udbrændthed</a>\n      <span class=\"im-dep-focus-tag\">Traumer</span>\n      <span class=\"im-dep-focus-tag\">Livskriser</span>\n      <span class=\"im-dep-focus-tag\">Familieudfordringer</span>\n      <span class=\"im-dep-focus-tag\">Parforholdsudfordringer</span>\n      <span class=\"im-dep-focus-tag\">Spiseforstyrrelser</span>\n    </div>\n  </div>\n</section>\n\n</div><!-- end .im-dep-page -->\n"}, "elements": []}]}]